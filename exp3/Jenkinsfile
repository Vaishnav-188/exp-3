
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Source code checked out'
            }
        }

        stage('Test') {
            steps {
                bat 'if not exist index.html exit /b 1'
                bat 'findstr /C:"Student Task Tracker" index.html'
                echo 'HTML test passed'
            }
        }

        stage('Build') {
            steps {
                bat 'if not exist build mkdir build'
                bat 'copy /Y index.html build\\index.html'
            }
        }

        stage('Deploy') {
            steps {
                bat 'if exist build\\index.html (echo Deployment successful) else (exit /b 1)'
            }
        }
    }

    post {
        success {
            echo 'CI/CD Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check Console Output.'
        }
    }
}
